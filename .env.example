# Required for GitHub repository/code search.
GITHUB_TOKEN=github_pat_xxx

# Required by Stage 3.
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5-mini

# Required by Stage 5 unless --skip-e2b is used. Use the numbered pair
# to run two independent pools with PIPELINE_E2B_CONCURRENCY slots each.
E2B_API_KEY=e2b_xxx
E2B_API_KEY1=
E2B_API_KEY2=

# Optional output location (default: ./output).
PIPELINE_OUTPUT_DIR=output
PIPELINE_MAX_REPO_SIZE_KB=100000
PIPELINE_FEATURE_ISSUE_LIMIT=10
PIPELINE_OPENAI_TIMEOUT_S=120
PIPELINE_OPENAI_MAX_OUTPUT_TOKENS=1000
PIPELINE_E2B_CPU_COUNT=1
PIPELINE_E2B_MEMORY_MB=1024
PIPELINE_E2B_CONCURRENCY=20
PIPELINE_PRESCREEN_CONCURRENCY=8
# Disabled by default so language mix never changes repository eligibility.
PIPELINE_LANGUAGE_QUOTA_ENABLED=false

# Optional: load another env file. Supported aliases in that file include
# MODEL_API_KEY, MODEL_BASE_URL, MODEL_NAME, and E2B_KEY.
# PIPELINE_ENV_FILE=/path/to/.env
