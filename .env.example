# Required for authenticated GitHub repository/code search. Numbered tokens are
# used as a round-robin pool by concurrent workers; GITHUB_TOKEN remains the
# single-token compatibility fallback.
GITHUB_TOKEN=
GITHUB_TOKEN1=
GITHUB_TOKEN2=

# Required by Stage 3.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5-mini

# Single-key fallback for non-production commands. Leave it empty when using
# the numbered keys below for continuous production.
E2B_API_KEY=

# Continuous production uses every numbered key that is present. Each key gets
# up to PIPELINE_E2B_CONCURRENCY slots, so 20 per key provides 20/40/60 total
# sandboxes for one/two/three configured keys.
E2B_API_KEY1=
E2B_API_KEY2=
E2B_API_KEY3=

# Optional output location (default: ./output).
PIPELINE_OUTPUT_DIR=output
PIPELINE_MAX_REPO_SIZE_KB=100000
PIPELINE_FEATURE_ISSUE_LIMIT=10
PIPELINE_OPENAI_TIMEOUT_S=120
PIPELINE_OPENAI_MAX_OUTPUT_TOKENS=1000
PIPELINE_E2B_CPU_COUNT=1
PIPELINE_E2B_MEMORY_MB=1024
PIPELINE_E2B_TEMPLATE_BUILD_TIMEOUT_S=900
PIPELINE_E2B_CONCURRENCY=20
PIPELINE_PRESCREEN_CONCURRENCY=20
# Streaming follower backpressure. Prescreen pauses at the high mark and
# resumes after E2B drains the queue below the low mark.
PENDING_HIGH_WATERMARK=480
PENDING_LOW_WATERMARK=120
# Continuous production defaults to ~/.cache/alvance-github-crawler/workspaces,
# never /tmp. Override with an explicit disk-backed path when needed.
# PIPELINE_WORKSPACE_TMPDIR=/home/your-user/.cache/alvance-github-crawler/workspaces
PIPELINE_WORKSPACE_MIN_FREE_MB=20480
# Total checkout budget. 640MB x 80 slots = 50GB, enough for 60 E2B workers
# plus 20 prescreen workers without allowing unbounded local disk growth.
PIPELINE_WORKSPACE_MAX_MB=51200
PIPELINE_WORKSPACE_RESERVATION_MB=640
PIPELINE_WORKSPACE_QUOTA_WAIT_S=900
# Disabled by default so language mix never changes repository eligibility.
PIPELINE_LANGUAGE_QUOTA_ENABLED=false

# Optional: load another env file. Supported aliases in that file include
# MODEL_API_KEY, MODEL_BASE_URL, MODEL_NAME, and E2B_KEY.
# PIPELINE_ENV_FILE=/path/to/.env
